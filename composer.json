    "keywords": [
        "TYPO3",
        "extension",
        "fluid",
        "slick",
        "slider"
    ],
    "authors": [
        {
            "name": "Manuel Munz",
            "email": "t3dev@comuno.net",
            "role": "Developer"
        }
    ],
    "license": "GPL-2.0-or-later",
    "require": {
