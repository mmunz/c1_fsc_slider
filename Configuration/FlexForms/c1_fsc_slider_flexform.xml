<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
        <langChildren>1</langChildren>
    </meta>
    <sheets>
        <general>
            <ROOT>
                <sheetTitle>General</sheetTitle>
                <type>array</type>
                <el>
                    <settings.header_tag>
                        <exclude>1</exclude>
                        <label>LLL:EXT:c1_fsc_slider/Resources/Private/Language/locallang_be.xlf:header_tag</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <label>span</label>
                                    <value>span</value>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <label>h1</label>
                                    <value>h1</value>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <label>h2</label>
                                    <value>h2</value>
                                </numIndex>
                                <numIndex index="3" type="array">
                                    <label>h3</label>
                                    <value>h3</value>
                                </numIndex>
                                <numIndex index="4" type="array">
                                    <label>h4</label>
                                    <value>h4</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.header_tag>
                </el>
            </ROOT>
        </general>
        <sDEF>
            <ROOT>
                <sheetTitle>Slider Options</sheetTitle>
                <type>array</type>
                <el>
                    <!-- Checkbox -->
                    <options.autoplay>
                        <exclude>1</exclude>
                        <label>LLL:EXT:c1_fsc_slider/Resources/Private/Language/locallang_be.xlf:flexform.autoplay</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </options.autoplay>
                    <options.infinite>
                        <exclude>1</exclude>
                        <label>LLL:EXT:c1_fsc_slider/Resources/Private/Language/locallang_be.xlf:flexform.infinite</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </options.infinite>
                    <options.fade>
                        <exclude>1</exclude>
                        <label>LLL:EXT:c1_fsc_slider/Resources/Private/Language/locallang_be.xlf:flexform.fade</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </options.fade>
                    <options.waitForAnimate>
                        <exclude>1</exclude>
                        <label>LLL:EXT:c1_fsc_slider/Resources/Private/Language/locallang_be.xlf:flexform.waitForAnimate</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </options.waitForAnimate>
                    <options.dots>
                        <exclude>1</exclude>
                        <label>LLL:EXT:c1_fsc_slider/Resources/Private/Language/locallang_be.xlf:flexform.dots</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </options.dots>
                    <options.arrows>
                        <exclude>1</exclude>
                        <label>LLL:EXT:c1_fsc_slider/Resources/Private/Language/locallang_be.xlf:flexform.arrows</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </options.arrows>
                    <options.speed>
                        <exclude>1</exclude>
                        <label>LLL:EXT:c1_fsc_slider/Resources/Private/Language/locallang_be.xlf:flexform.speed</label>
                        <config>
                            <type>input</type>
                            <default>2000</default>
                            <eval>int</eval>
                        </config>
                    </options.speed>
                    <options.autoplaySpeed>
                        <exclude>1</exclude>
                        <label>LLL:EXT:c1_fsc_slider/Resources/Private/Language/locallang_be.xlf:flexform.autoplaySpeed</label>
                        <config>
                            <type>input</type>
                            <default>4000</default>
                            <eval>int</eval>
                        </config>
                    </options.autoplaySpeed>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
